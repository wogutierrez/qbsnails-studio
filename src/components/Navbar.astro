    <a href="/" class="navbar-brand fw-bold" style="color: var(--primary); font-size: 1.5rem;">QBS Nails</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <li class="nav-item"><a href="/" class="nav-link fw-medium" style="color: #110303;">Home</a></li>
        <li class="nav-item"><a href="/services" class="nav-link fw-medium" style="color: #110303;">Services</a></li>
        <li class="nav-item"><a href="/contact" class="nav-link fw-medium" style="color: #110303;">Contact</a></li>
        <li class="nav-item ms-2">
          <select id="themeSelector" class="form-select form-select-sm" style="border-color: var(--secondary); width: 130px;">
            <option value="default">🎨 Original</option>
            <option value="cool">❄️ Cool</option>
