---
// Navbar Component Frontmatter
---

<!-- =========================================================================
     OPTIONAL: SECTION BORDER
     To enable a bottom border using your secondary brand color, swap the <nav> 
     tag below with this line:
     <nav class="navbar navbar-expand-lg sticky-top bg-white border-bottom border-secondary">
========================================================================= -->

<nav class="navbar navbar-expand-lg sticky-top bg-white">
  <div class="container">
    
    <!-- Brand Logo -->
    <a href="/" class="navbar-brand d-flex align-items-center">
      <img src="/Logo.png" alt="QutiQled Logo" height="50" class="me-2" />
    </a>
    
    <!-- Mobile Hamburger Toggle Button -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <!-- Navigation Links & Interactive Controls -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <li class="nav-item"><a href="/" class="nav-link fw-bold text-dark">Home</a></li>
        <li class="nav-item"><a href="/services" class="nav-link fw-bold text-dark">Services</a></li>
        <li class="nav-item"><a href="/shop" class="nav-link fw-bold text-dark">Shop</a></li>
        <li class="nav-item"><a href="/contact" class="nav-link fw-bold text-dark">Contact</a></li>
        
        <!-- =================================================================
             DISABLED FEATURE: THEME SELECTOR DROPDOWN
             Uncomment this <li> block to enable the theme picker in the navbar.
        ================================================================== -->
        <!-- 
        <li class="nav-item ms-2 d-flex align-items-center gap-2">
          <label for="themeSelector" class="fw-bold small text-dark">Theme:</label>
          <select id="themeSelector" class="form-select form-select-sm border-secondary w-auto" aria-label="Select theme">
            <option value="default">🎨 Original</option>
            <option value="cool">❄️ Cool</option>
            <option value="warm">🔥 Warm</option>
          </select>
        </li>
        -->
      </ul>
    </div>

  </div>
</nav>

