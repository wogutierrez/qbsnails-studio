---
import ServiceCard from "./ServiceCard.astro";

const { services = [] } = Astro.props;

const rawCategories = services.map((s) => s.category).filter(Boolean);
const categories = ["All", ...Array.from(new Set(rawCategories))];
---

<div class="service-filter-wrapper w-full">
  {/* CATEGORY FILTER BUTTONS */}
  <div class="flex flex-wrap justify-end items-center w-full gap-2 mb-8">
    {
      categories.map((cat, index) => (
        <button
          type="button"
          data-filter={cat}
          class={`filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all ${
            index === 0
              ? "active bg-rose-600 text-white shadow-md"
              : "bg-gray-100 text-gray-600 hover:bg-rose-100 hover:text-rose-600"
          }`}
        >
          {cat}
        </button>
      ))
    }
  </div>

  {/* SERVICE CARDS GRID */}
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 w-full">
    {
      services.map((service) => (
        <div class="service-card-item" data-category={service.category}>
          <ServiceCard
            name={service.name}
            price={service.price}
            duration={service.duration}
            badge={service.badge}
            category={service.category}
            description={service.description}
            image={service.image}
          />
        </div>
      ))
    }
  </div>
</div>

<script>
  function setupFilter() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cardItems = document.querySelectorAll<HTMLElement>(".service-card-item");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selectedCategory = btn.dataset.filter;

        filterBtns.forEach((b) => {
          b.classList.remove("active", "bg-rose-600", "text-white", "shadow-md");
          b.classList.add("bg-gray-100", "text-gray-600", "hover:bg-rose-100", "hover:text-rose-600");
        });

        btn.classList.add("active", "bg-rose-600", "text-white", "shadow-md");
        btn.classList.remove("bg-gray-100", "text-gray-600", "hover:bg-rose-100", "hover:text-rose-600");

        cardItems.forEach((card) => {
          const cardCategory = card.dataset.category;

          if (selectedCategory === "All" || cardCategory === selectedCategory) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  }

  setupFilter();
  document.addEventListener("astro:page-load", setupFilter);
</script>