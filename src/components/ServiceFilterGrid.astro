---
import ServiceCard from "./ServiceCard.astro";
const { services = [] } = Astro.props;

// Extract unique categories from services
const rawCategories = services
  .map((s) => s.category)
  .filter((cat) => Boolean(cat));

const categories = ["All", ...new Set(rawCategories)];
---

<!-- CATEGORY FILTER BUTTONS -->
<div class="d-flex flex-wrap gap-2 mb-4 justify-content-end">
  {
    categories.map((cat, index) => (
      <button
        type="button"
        class={`btn px-4 py-2 rounded-pill fw-semibold btn-filter ${index === 0 ? "active" : ""}`}
        data-filter={cat}
        style={
          index === 0
            ? "background: var(--primary); color: #ffffff; border: 2px solid var(--primary);"
            : "background: #f8f9fa; color: #110303; border: 2px solid var(--secondary);"
        }
      >
        {cat}
      </button>
    ))
  }
</div>

<!-- SERVICE CARDS GRID -->
<div class="row g-4 w-100">
  {
    services.map((service) => (
      <div class="col-md-6 col-lg-4 service-card-item" data-category={service.category}>
        <ServiceCard
          name={service.name}
          price={service.price}
          duration={service.duration}
          badge={service.badge}
          category={service.category}
          description={service.description}
          calLink={service.calLink}
          image={service.image}
        />
      </div>
    ))
  }
</div>

<!-- FILTER SCRIPT -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filterButtons = document.querySelectorAll(".btn-filter");
    const serviceItems = document.querySelectorAll(".service-card-item");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => {
          b.classList.remove("active");
          b.style.background = "#f8f9fa";
          b.style.color = "#110303";
          b.style.border = "2px solid var(--secondary)";
        });

        btn.classList.add("active");
        btn.style.background = "var(--primary)";
        btn.style.color = "#ffffff";
        btn.style.border = "2px solid var(--primary)";

        const selectedCategory = btn.getAttribute("data-filter");

        serviceItems.forEach((item) => {
          const itemCategory = item.getAttribute("data-category");

          if (selectedCategory === "All" || itemCategory === selectedCategory) {
            item.style.display = "block";
          } else {
            item.style.display = "none";
          }
        });
      });
    });
  });
</script>