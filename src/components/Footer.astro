---
const currentYear = new Date().getFullYear();
---

<footer class="border-top py-4 mt-5" style="border-color: var(--secondary) !important; background: #ffffff;">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 text-center text-md-start">
      <p class="small fw-medium mb-0" style="color: #110303;">
        &copy; {currentYear} <span class="fw-semibold" style="color: #110303;">Qutiqled beauty Studio</span>. All rights reserved.
      </p>
      <div class="d-flex align-items-center gap-2">
        <span class="small fw-medium" style="color: #110303;">Digital Architecture by</span>
        <a href="https://escatega.com" target="_blank" rel="noopener noreferrer" class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill text-white text-decoration-none small fw-semibold" style="background: #110303;">
          <span>ESCATEGA</span>
          <svg xmlns="http://www.w3.org/2000/svg" style="width: 12px; height: 12px; color: var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="7 17 17 7 17 17"></polyline>
            <polyline points="7 7 17 7"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>