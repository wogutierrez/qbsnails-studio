---
const { name, price, duration, badge, description, image, category, calLink } = Astro.props;

// Uses calLink if provided; falls back to /contact if empty
const bookingUrl = calLink 
  ? (calLink.startsWith('http') ? calLink : `https://cal.com/${calLink}`)
  : '/contact';
---

<div class="card h-100 border-0" style="background: #ffffff; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border-radius: 16px; overflow: hidden;">
  {badge && (
    <span class="position-absolute top-0 end-0 mt-3 me-3 px-3 py-1 rounded-pill fw-bold text-white z-1 text-uppercase" style="background: var(--primary); font-size: 0.7rem; letter-spacing: 0.05em;">
      {badge}
    </span>
  )}
  <div class="position-relative overflow-hidden" style="aspect-ratio: 16/9; background: rgba(3,152,158,0.05);">
    {image ? (
      <img src={image.url} alt={image.alt || name} class="w-100 h-100 object-fit-cover" />
    ) : (
      <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-4" style="color: #110303;">
        <svg class="mb-2" style="width: 40px; height: 40px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke-width="1.5"/>
          <circle cx="8.5" cy="8.5" r="1.5" stroke-width="1.5"/>
          <path d="M21 15l-5-5L5 21" stroke-width="1.5"/>
        </svg>
        <span class="text-uppercase fw-semibold" style="color: #110303; font-size: 0.65rem;">Portfolio Shot Coming Soon</span>
      </div>
    )}
    {category && (
      <span class="position-absolute bottom-0 start-0 mb-2 ms-2 px-2 py-1 rounded text-white text-uppercase" style="background: #110303; font-size: 0.6rem; font-weight: 600;">
        {category}
      </span>
    )}
  </div>
  <div class="card-body d-flex flex-column" style="background: #ffffff;">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <h3 class="card-title fw-bold mb-0" style="color: #110303; font-size: 1.25rem;">{name}</h3>
      <div class="text-end ms-2 flex-shrink-0">
        <span class="fw-bold" style="color: var(--primary); font-size: 1.5rem;">{price}</span>
        {duration && <p class="mb-0 small" style="color: #110303;">{duration}</p>}
      </div>
    </div>
    <p class="card-text flex-grow-1 small" style="color: #110303;">{description}</p>
  </div>
  <div class="card-footer bg-transparent border-top pt-3" style="border-color: var(--secondary) !important; background: #ffffff;">
    <div class="d-flex justify-content-between align-items-center">
      <span class="small fw-semibold" style="color: #110303;">💅 Executed by Tafadzwa & Team</span>
      <a href={bookingUrl} target={calLink ? "_blank" : "_self"} rel={calLink ? "noopener noreferrer" : undefined} class="fw-bold text-decoration-none small" style="color: var(--primary);">Book Appointment →</a>
    </div>
  </div>
</div>