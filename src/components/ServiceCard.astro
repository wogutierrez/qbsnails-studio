---
const { name, price, duration, badge, description, image, category } =
  Astro.props;
---

<div class="card h-100 border-0 shadow-sm overflow-hidden">
  {badge && (
    <span class="position-absolute top-0 end-0 mt-3 me-3 px-3 py-1 rounded-pill fw-bold text-white bg-primary z-1 text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">
      {badge}
    </span>
  )}

  <div class="position-relative overflow-hidden bg-light" style="aspect-ratio: 16/9;">
    {image ? (
      <img
        src={image.url}
        alt={image.alt || name}
        class="w-100 h-100 object-fit-cover"
      />
    ) : (
      <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-4 text-secondary">
        <svg class="mb-2" style="width: 40px; height: 40px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke-width="1.5"/>
          <circle cx="8.5" cy="8.5" r="1.5" stroke-width="1.5"/>
          <path d="M21 15l-5-5L5 21" stroke-width="1.5"/>
        </svg>
        <span class="text-uppercase fw-semibold text-secondary" style="font-size: 0.65rem; letter-spacing: 0.05em;">
          Portfolio Shot Coming Soon
        </span>
      </div>
    )}
    
    {category && (
      <span class="position-absolute bottom-0 start-0 mb-2 ms-2 px-2 py-1 rounded text-white bg-dark bg-opacity-75 text-uppercase" style="font-size: 0.6rem; font-weight: 600;">
        {category}
      </span>
    )}
  </div>

  <div class="card-body d-flex flex-column">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <h5 class="card-title fw-bold text-dark mb-0">{name}</h5>
      <div class="text-end ms-2 flex-shrink-0">
        <span class="fw-bold text-primary" style="font-size: 1.5rem;">{price}</span>
        {duration && <p class="text-secondary mb-0 small">{duration}</p>}
      </div>
    </div>
    <p class="card-text text-secondary flex-grow-1 small">{description}</p>
  </div>

  <div class="card-footer bg-transparent border-top pt-3">
    <div class="d-flex justify-content-between align-items-center">
      <span class="text-secondary small fw-semibold">💅 Executed by Tafadzwa & Team</span>
      <a href="/contact" class="text-primary fw-bold text-decoration-none small">
        Book Appointment →
      </a>
    </div>
  </div>
</div>