---
// src/layouts/Layout.astro
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title = "Qutiqled Beauty | Premium Nail Care Delivered to Your Door" } = Astro.props;
---
<!doctype html>
<!-- <html lang="en"> -->
<html lang="en" data-theme="warm">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Meta Description for SEO -->
    <meta name="description" content="Premium nail care products and professional tools delivered to your door in Harare. Curated by Tafadzwa Shiripinda for the Zimbabwe beauty community." />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <title>{title}</title>
  </head>
  
  <body class="bg-background text-text font-sans antialiased min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    
    <!-- Bootstrap JavaScript (needed for burger menu) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>