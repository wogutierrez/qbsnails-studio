---
// Import your project's global CSS file so Tailwind compiles
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title = "Qutiqled Beauti Studio | Luxury Nail Salon Harare" } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body
    class="bg-white text-gray-900 font-sans antialiased min-h-screen flex flex-col"
  >
    <Navbar />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
