---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Booking Confirmed | Qutiqled Beauty">

  <!-- SECTION: CONFIRMATION MESSAGE -->
  <section style="background: #ffffff; padding-top: 6rem; padding-bottom: 6rem;">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
          <div class="p-5 rounded-4" style="background: #ffffff; border: 2px solid var(--secondary); box-shadow: 0 20px 60px rgba(0,0,0,0.05);">
            <div class="display-3 mb-4">✨</div>
            <span class="badge-custom d-inline-block mb-3">Appointment Scheduled</span>
            <h1 class="display-5 fw-bold mb-3" style="color: #110303;">
              Thank You for Booking!
            </h1>
            <p class="fs-5 mb-4" style="color: #110303; max-width: 600px; margin-left: auto; margin-right: auto;">
              Your appointment has been successfully scheduled. Tafadzwa and the team are looking forward to delivering premium nail care right to your door in Harare.
            </p>
            <p class="small text-muted mb-5">
              Check your inbox for a confirmation email with all appointment details.
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-3">
              <a href="/services" class="btn btn-primary-custom">Return to Services</a>
              <a href="/" class="btn btn-outline-custom">Back to Home</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>