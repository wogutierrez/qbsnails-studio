---
import Layout from "../layouts/Layout.astro";
import ServiceFilterGrid from "../components/ServiceFilterGrid.astro";
import { getCollection } from "astro:content";

const serviceEntries = await getCollection("services");

const services = serviceEntries.map((entry) => ({
  name: entry.data.name,
  price: entry.data.price,
  duration: entry.data.duration,
  badge: entry.data.badge,
  category: entry.data.category,
  description: entry.data.description,
  image: entry.data.image ? {
    url: entry.data.image,
    alt: entry.data.name,
  } : null,
}));

const reviewEntries = await getCollection("reviews");

const reviews = reviewEntries.map((entry) => ({
  name: entry.data.name,
  suburb: entry.data.suburb,
  text: entry.data.text,
  rating: entry.data.rating || 5,
}));
---

<Layout title="Services & Menu | Qutiqled Beauty Harare">

  <!-- SECTION 1: HERO -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem;">
    <div class="container">
      <div class="text-center mx-auto" style="max-width: 700px;">
        <span class="badge-custom d-inline-block mb-3">📍 Serving Harare & Surrounding Areas</span>
        <h1 class="display-4 fw-bold mb-3" style="color: #110303;">Our Services</h1>
        <p style="color: #110303; font-size: 1.25rem;">
          Professional nail care delivered to your door. Healthy natural nail restoration,
          and bespoke hand-painted artwork led by certified Master Nail
          Specialist
          <strong style="color: var(--primary);">Tafadzwa Shiripinda</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: SPECIALIST SPOTLIGHT -->
<section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem; border-top: 2px solid var(--secondary); border-bottom: 2px solid var(--secondary);">
  <div class="container">
    <div class="rounded-4 p-5 text-center" style="background: #110303;">
      <span class="badge-custom d-inline-block mb-3" style="background: var(--accent) !important; color: #110303 !important;">Lead Nail Technician & Founder</span>
      <h2 class="display-6 fw-bold mb-3 text-white">Meet Tafadzwa Shiripinda</h2>
      <p class="text-white-50 mx-auto mb-4" style="max-width: 700px;">Tafadzwa is a dedicated nail professional with a genuine love for natural nail health and artistic expression. With 3 years of experience, she takes pride in delivering quality care and beautiful results that her clients love.</p>
      <div class="d-flex flex-wrap justify-content-center gap-2">
        <span class="badge" style="background: rgba(255,255,255,0.1); color: white; padding: 0.5rem 1rem;">✨ Certified Gel Specialist</span>
        <span class="badge" style="background: rgba(255,255,255,0.1); color: white; padding: 0.5rem 1rem;">🌿 Non-Toxic Products</span>
        <span class="badge" style="background: rgba(255,255,255,0.1); color: white; padding: 0.5rem 1rem;">🏆 100+ Happy Clients</span>
      </div>
    </div>
  </div>
</section>


  <!-- SECTION 3: TREATMENT MENU -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem;">
    <div class="container">
      <div class="border-bottom pb-3 mb-4" style="border-color: var(--secondary) !important;">
        <h2 class="fw-bold" style="color: #110303; font-size: 2.5rem;">Treatment & Art Menu</h2>
        <p style="color: #110303; font-size: 0.9rem;">All prices payable in USD / ZiG equivalent at daily official rate</p>
      </div>
      <ServiceFilterGrid services={services} />
    </div>
  </section>

  <!-- SECTION 4: SERVICE HOURS & POLICIES -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem; border-top: 2px solid var(--secondary); border-bottom: 2px solid var(--secondary);">
    <div class="container">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="p-4 rounded-4" style="border: 2px solid var(--secondary);">
            <h3 class="fw-bold mb-3" style="color: #110303;">🕒 Service Hours</h3>
            <ul class="list-unstyled">
              <li class="d-flex justify-content-between border-bottom py-2" style="border-color: rgba(17,3,3,0.1);">
                <span style="color: #110303;">Tuesday – Friday</span>
                <span class="fw-semibold" style="color: #110303;">8:30 AM – 5:30 PM</span>
              </li>
              <li class="d-flex justify-content-between border-bottom py-2" style="border-color: rgba(17,3,3,0.1);">
                <span style="color: #110303;">Saturday</span>
                <span class="fw-semibold" style="color: #110303;">8:00 AM – 6:00 PM</span>
              </li>
              <li class="d-flex justify-content-between py-2" style="color: var(--primary);">
                <span>Sunday & Monday</span>
                <span class="fw-semibold">Closed (Private Bridal Only)</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-4 rounded-4" style="border: 2px solid var(--secondary);">
            <h3 class="fw-bold mb-3" style="color: #110303;">📋 Appointment & Hygiene Policy</h3>
            <ul class="list-unstyled">
              <li class="d-flex gap-2 mb-2">
                <span style="color: var(--secondary);">✔</span>
                <span style="color: #110303;">Hospital-grade autoclaved tool sterilization for every client.</span>
              </li>
              <li class="d-flex gap-2 mb-2">
                <span style="color: var(--secondary);">✔</span>
                <span style="color: #110303;">We come to you - enjoy professional care in your own space.</span>
              </li>
              <li class="d-flex gap-2">
                <span style="color: var(--secondary);">✔</span>
                <span style="color: #110303;">Cash (USD) or EcoCash / ZiG bank transfer accepted.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: TESTIMONIALS -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem;">
    <div class="container">
      <h3 class="text-center fw-bold mb-4" style="color: #110303; font-size: 2.5rem;">What Our Clients Say</h3>
      <div class="row g-4">
        {reviews.map((rev) => (
          <div class="col-md-6">
            <div class="p-4 rounded-4 h-100 d-flex flex-column" style="border: 2px solid var(--secondary);">
              <div class="mb-2" style="color: var(--accent); font-size: 0.9rem;">
                {Array.from({ length: rev.rating }).map(() => (<span>★</span>))}
              </div>
              <p class="fst-italic flex-grow-1 mb-3" style="color: #110303; font-size: 0.95rem; line-height: 1.625;">"{rev.text}"</p>
              <div class="pt-2 border-top fw-bold" style="color: #110303; border-color: var(--secondary) !important;">
                — {rev.name}
                {rev.suburb && (<span class="fw-normal small ms-1" style="color: var(--primary);">({rev.suburb})</span>)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 6: CALL TO ACTION -->
<section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem; border-top: 2px solid var(--secondary);">
  <div class="container">
    <div class="rounded-4 p-5 text-center" style="background: #110303;">
      <h2 class="display-6 fw-bold mb-3 text-white">Ready for your transformation with Tafadzwa?</h2>
      <p class="text-white-50 mx-auto mb-4" style="max-width: 600px;">Book your appointment online and experience professional nail care in the comfort of your home.</p>
      <div class="d-flex flex-wrap justify-content-center gap-3">
        <a href="/contact" class="btn" style="background: #ffffff; color: var(--primary); font-weight: 700; padding: 0.75rem 2rem; border-radius: 50px;">Book Online</a>
        <a href="tel:+263770000000" class="btn btn-outline-light" style="font-weight: 700; padding: 0.75rem 2rem; border-radius: 50px; border-width: 2px;">Call Us (+263)</a>
      </div>
    </div>
  </div>
</section>

</Layout>