---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Qutiqled Beauty Harare">

  <!-- SECTION 1: HERO -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem;">
    <div class="container" style="max-width: 960px;">
      <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-2" style="color: var(--primary);">Get in Touch</h1>
        <p style="color: #110303; font-size: 1.25rem; max-width: 720px;" class="mx-auto">
          Need custom nail art, group pamper packages, or have questions about our mobile travel areas across Harare? Drop us a note below!
        </p>
        
        <!-- Optional Badge linking to Automated Booking -->
        <div class="mt-3">
          <span class="badge rounded-pill px-3 py-2" style="background-color: var(--secondary); color: #110303; font-size: 0.95rem; border: 1px solid var(--primary);">
            ✨ Ready for immediate booking? Use our online booking system on the home page!
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: CONTACT FORM & INFO -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem; border-top: 2px solid var(--secondary); border-bottom: 2px solid var(--secondary);">
    <div class="container" style="max-width: 960px;">
      <div class="row g-4">
        
        <!-- Column 1: Contact Form -->
        <div class="col-md-6">
          <div class="p-4 p-md-5 rounded-4" style="border: 2px solid var(--secondary);">
            
            <!-- CONNECTED FORMSUBMIT FORM WITH THANK YOU REDIRECT -->
            <form action="https://formsubmit.co/info@qbsnails.com" method="POST">
              
              <!-- FormSubmit Configuration -->
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_subject" value="💅 New Web Contact / Booking Request - QutiQled" />
              <!-- Redirect to your new thank-you page after submit -->
              <input type="hidden" name="_next" value="https://qbsnails.com/thank-you" />

              <!-- Full Name -->
              <div class="mb-3">
                <label class="form-label fw-bold" style="color: #110303;">Full Name</label>
                <input type="text" name="Full Name" class="form-control" required placeholder="Jane Doe" style="border: 2px solid var(--secondary); border-radius: 12px;">
              </div>

              <!-- Email Address -->
              <div class="mb-3">
                <label class="form-label fw-bold" style="color: #110303;">Email Address</label>
                <input type="email" name="Email" class="form-control" required placeholder="jane@example.com" style="border: 2px solid var(--secondary); border-radius: 12px;">
              </div>

              <!-- Interested Service -->
              <div class="mb-3">
                <label class="form-label fw-bold" style="color: #110303;">Interested Service</label>
                <select name="Service" class="form-select" style="border: 2px solid var(--secondary); border-radius: 12px;">
                  <option value="">Select a service...</option>
                  <option value="Classic Manicure">Classic Manicure</option>
                  <option value="Gel Manicure">Gel Manicure</option>
                  <option value="Luxury Pedicure">Luxury Pedicure</option>
                  <option value="Custom Nail Art / Other">Custom Nail Art / Other</option>
                </select>
              </div>

              <!-- Your Address -->
              <div class="mb-3">
                <label class="form-label fw-bold" style="color: #110303;">Your Address / Suburb</label>
                <input type="text" name="Address" class="form-control" placeholder="Enter your suburb or address for home service" style="border: 2px solid var(--secondary); border-radius: 12px;">
              </div>

              <!-- Message -->
              <div class="mb-3">
                <label class="form-label fw-bold" style="color: #110303;">Message</label>
                <textarea name="Message" rows="4" class="form-control" required placeholder="Tell us about your preferred date, time, or nail design ideas..." style="border: 2px solid var(--secondary); border-radius: 12px;"></textarea>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="btn w-100 fw-bold py-3 rounded-3 text-white" style="background: var(--primary);">Send Message</button>
            
            </form>

          </div>
        </div>

        <!-- Column 2: Service Information -->
        <div class="col-md-6">
          <div class="p-4 p-md-5 rounded-4 h-100 d-flex flex-column justify-content-between" style="border: 2px solid var(--secondary);">
            <div>
              <h2 class="fw-bold mb-4" style="color: #110303;">Service Information</h2>
              <div style="color: #110303;">
                <div class="mb-3">
                  <p class="fw-bold mb-0" style="color: var(--primary);">Service Area</p>
                  <p class="mb-0">Harare & Surrounding Areas</p>
                </div>
                <div class="mb-3">
                  <p class="fw-bold mb-0" style="color: var(--primary);">Hours</p>
                  <p class="mb-0">Tuesday – Saturday: 9:00 AM – 6:00 PM</p>
                  <p class="mb-0">Sunday – Monday: Closed</p>
                </div>
                <div>
                  <p class="fw-bold mb-0" style="color: var(--primary);">Contact</p>
                  <p class="mb-0">Email: info@qbsnails.com</p>
                  <p class="mb-0">Phone: +263 77 123 4567</p>
                </div>
              </div>
            </div>
            <div class="mt-4 p-3 rounded-3" style="border: 2px solid var(--secondary);">
              🏠 <strong style="color: #110303;">Mobile Service:</strong> We come to you! Enjoy professional nail care in the comfort of your own home.
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 3: CALL TO ACTION -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem;">
    <div class="container">
      <div class="rounded-4 p-5 text-center" style="background: #110303;">
        <h2 class="display-6 fw-bold mb-3 text-white">Book Your Mobile Appointment</h2>
        <p class="text-white-50 mx-auto mb-4" style="max-width: 600px;">We come to your home in Harare and surrounding areas. Bookings recommended for custom nail art!</p>
        <a href="tel:+263770000000" class="btn" style="background: var(--primary); color: white; font-weight: 700; padding: 0.75rem 2rem; border-radius: 50px;">Call Us</a>
      </div>
    </div>
  </section>

</Layout>