---
import Layout from "../layouts/Layout.astro";

import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Qutiqled beauty Studio">
  <div class="container mx-auto px-4 py-12 max-w-5xl">
    
    {/* Page Title */}
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-extrabold text-pink-600 mb-2">
        Get in Touch
      </h1>
      <p class="text-gray-600">
        Have a question or want to book an appointment? Send us a message!
      </p>
    </div>

    {/* 2-Column Responsive Grid */}
    <div class="grid md:grid-cols-2 gap-10">
      
      {/* COLUMN 1: Contact Form */}
      <div class="bg-white p-8 rounded-lg border border-gray-200 shadow-sm">
        <form class="space-y-4">
          
          {/* Name Field */}
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-1" for="name">
              Full Name
            </label>
            <input
              type="text"
              id="name"
              placeholder="Jane Doe"
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-pink-500"
            />
          </div>

          {/* Email Field */}
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-1" for="email">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              placeholder="jane@example.com"
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-pink-500"
            />
          </div>

          {/* Service Dropdown */}
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-1" for="service">
              Interested Service
            </label>
            <select
              id="service"
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-pink-500 bg-white"
            >
              <option value="">Select a service...</option>
              <option value="classic">Classic Manicure</option>
              <option value="gel">Gel Manicure</option>
              <option value="pedicure">Luxury Pedicure</option>
              <option value="other">Custom Nail Art / Other</option>
            </select>
          </div>

          {/* Message Field */}
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-1" for="message">
              Message
            </label>
            <textarea
              id="message"
              rows="4"
              placeholder="Tell us about your preferred date or nail design ideas..."
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-pink-500"
            ></textarea>
          </div>

          {/* Submit Button */}
          <button
            type="button"
            class="w-full bg-pink-600 hover:bg-pink-700 text-white font-bold py-3 px-6 rounded-md shadow transition-colors"
          >
            Send Message
          </button>

        </form>
      </div>

      {/* COLUMN 2: Studio Information */}
      <div class="flex flex-col justify-between space-y-6 bg-pink-50 p-8 rounded-lg border border-pink-100">
        <div>
          <h2 class="text-xl font-bold text-gray-800 mb-4">
            Studio Information
          </h2>
          
          <div class="space-y-4 text-gray-700">
            <div>
              <p class="font-bold text-pink-600">Location</p>
              <p>123 Beauty Lane, Suite 101</p>
            </div>

            <div>
              <p class="font-bold text-pink-600">Hours</p>
              <p>Tuesday – Saturday: 9:00 AM – 6:00 PM</p>
              <p>Sunday – Monday: Closed</p>
            </div>

            <div>
              <p class="font-bold text-pink-600">Contact</p>
              <p>Email: info@qbsnails.com</p>
              <p>Phone: (555) 019-2834</p>
            </div>
          </div>
        </div>

        <div class="p-4 bg-white rounded border border-pink-200 text-sm text-gray-600">
          ✨ <strong>Appointments:</strong> Walk-ins are welcome based on availability, but bookings are recommended for custom art!
        </div>
      </div>

    </div>
  </div>
</Layout>