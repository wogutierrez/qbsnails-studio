---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Message Sent | QutiQled Beauty">
  <section style="background: #ffffff; padding-top: 6rem; padding-bottom: 6rem;">
    <div class="container text-center" style="max-width: 600px;">
      <div class="p-5 rounded-4 shadow-sm" style="border: 2px solid var(--secondary);">
        <h1 class="display-5 fw-bold mb-3" style="color: var(--primary);">Thank You! ✨</h1>
        <p class="fs-5 mb-4" style="color: #110303;">
          Your message has been received. We will get back to you shortly regarding your booking or inquiry!
        </p>
        <a href="/" class="btn fw-bold py-3 px-4 rounded-3 text-white" style="background: var(--primary);">
          Return to Home
        </a>
      </div>
    </div>
  </section>
</Layout>