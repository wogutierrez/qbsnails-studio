import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";

import { getCollection } from "astro:content";

// 1. Fetch live services from CMS
const allServices = await getCollection("services");

// 2. Pure JavaScript filtering for featured items 0
const featuredEntries = [];
for (let i = 0; i < allServices.length; i++) {
  if (allServices[i].data && allServices[i].data.featured === true) {
    featuredEntries.push(allServices[i]);
  }
}

// Fallback0: If no services are checked as featured yet, take the first 3
const displayEntries = featuredEntries.length > 0 ? featuredEntries : allServices.slice(0, 3);

// 3. Format images for ServiceCard using standard JavaScript
const services = displayEntries.map(function (entry) {
  return {
    name: entry.data.name,
    price: entry.data.price,
    duration: entry.data.duration,
    badge: entry.data.badge,
    category: entry.data.category,
    description: entry.data.description,
    image: entry.data.image
      ? {
          url: entry.data.image,
          alt: entry.data.name,
        }
      : null,
  };
});

// Highlighted featured services for the home page
const highlights = [
  {
    icon: "🌿",
    title: "Non-Toxic & Health-First",
    desc: "We prioritize natural nail integrity using premium, damage-free gel systems.",
  },
  {
    icon: "💎",
    title: "Precision Craftsmanship",
    desc: "Every set is personally crafted or inspected by Master Specialist Tafadzwa Shiripinda.",
  },
  {
    icon: "✨",
    title: "Sterile & Hygienic",
    desc: "Hospital-grade autoclaved tools and single-use files for total peace of mind.",
  },
];
---

<Layout title="Qutiqled beauty Studio | Luxury Nail Salon in Avondale, Harare">
  {/* SECTION 1: HERO BANNER */}
  <section
    class="bg-gradient-to-b from-[var(--color-accent)]/10 via-[var(--color-primary)]/5 to-[var(--color-background)] py-16 md:py-24 px-4"
  >
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span
          class="text-xs font-bold uppercase tracking-widest text-[var(--color-secondary)] bg-[var(--color-secondary)]/10 border border-[var(--color-secondary)]/20 px-3.5 py-1.5 rounded-full inline-block mb-4"
        >
          📍 Avondale Shopping Centre, Harare
        </span>
        <h1
          class="text-4xl md:text-6xl font-black text-[var(--color-text)] leading-tight mb-6 tracking-tight"
        >
          Elegance Crafted for Your <span class="text-[var(--color-primary)]">Nails.</span>
        </h1>
        <p class="text-[var(--color-text)]/80 text-lg leading-relaxed mb-8">
          Welcome to Qutiqled Beauty Studio—Harare's premier destination for
          luxury gel overlays, spa pedicures, and bespoke hand-painted artwork
          led by <strong class="text-[var(--color-text)]">Tafadzwa Shiripinda</strong>.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/services"
            class="bg-[var(--color-primary)] hover:opacity-90 text-white font-bold py-3.5 px-8 rounded-full shadow-lg hover:shadow-xl transition-all text-center"
          >
            Explore Treatment Menu
          </a>
          <a
            href="/contact"
            class="bg-[var(--color-background)] hover:bg-[var(--color-accent)]/10 text-[var(--color-secondary)] font-bold border-2 border-[var(--color-secondary)] py-3.5 px-8 rounded-full transition-all text-center"
          >
            Book Appointment
          </a>
        </div>
      </div>

      {/* Hero Visual Box */}
      <div class="relative">
        <div
          class="aspect-square rounded-3xl bg-gradient-to-tr from-[var(--color-accent)]/20 to-[var(--color-primary)]/20 overflow-hidden shadow-2xl border-4 border-[var(--color-background)] relative flex items-center justify-center"
        >
          <img
            src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=800&q=80"
            alt="Qutiqled beauty Studio Nails"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute bottom-4 left-4 right-4 bg-[var(--color-background)]/90 backdrop-blur-md p-4 rounded-2xl border border-[var(--color-background)]/50 shadow-lg"
          >
            <p class="text-xs font-bold text-[var(--color-text)]/60 uppercase tracking-wider">
              Lead Specialist
            </p>
            <p class="text-sm font-extrabold text-[var(--color-text)]">
              Tafadzwa Shiripinda
            </p>
            <p class="text-xs text-[var(--color-secondary)] font-medium">
              8+ Years Experience in Harare
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* SECTION 2: WHY CHOOSE US */}
  <section class="py-16 bg-[var(--color-background)] border-y border-[var(--color-accent)]/20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-[var(--color-text)] mb-3">
          The Qutiqled Experience
        </h2>
        <p class="text-[var(--color-text)]/70 text-sm md:text-base">
          We combine international gel standards with personalized African
          artistry.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          highlights.map((item) => (
            <div class="p-6 rounded-2xl bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/20 text-center hover:bg-[var(--color-accent)]/20 transition-colors">
              <div class="text-4xl mb-3">{item.icon}</div>
              <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">{item.title}</h3>
              <p class="text-[var(--color-text)]/80 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* SECTION 3: FEATURED SERVICES PREVIEW */}
  <section class="py-16 bg-[var(--color-accent)]/5">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <span
            class="text-xs font-bold uppercase tracking-widest text-[var(--color-primary)]"
            >Popular Treatments</span
          >
          <h2 class="text-3xl font-black text-[var(--color-text)] mt-1">
            Featured Services
          </h2>
        </div>
        <a
          href="/services"
          class="text-[var(--color-secondary)] font-bold text-sm hover:underline mt-4 md:mt-0"
        >
          View Full Menu & Pricing &rarr;
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          services.map((service) => (
            <ServiceCard
              name={service.name}
              price={service.price}
              duration={service.duration}
              badge={service.badge}
              category={service.category}
              description={service.description}
              image={service.image}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* SECTION 4: CALL TO ACTION BANNER */}
  <section class="py-16 px-4 bg-[var(--color-background)]">
    <div
      class="max-w-4xl mx-auto bg-[var(--color-text)] text-[var(--color-background)] rounded-3xl p-10 md:p-12 text-center shadow-2xl relative overflow-hidden"
    >
      <div class="relative z-10">
        <span
          class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] bg-[var(--color-accent)]/10 px-3.5 py-1 rounded-full inline-block mb-4 border border-[var(--color-accent)]/30"
        >
          Appointments Recommended
        </span>
        <h2 class="text-3xl md:text-4xl font-black mb-4">
          Ready for Your Studio Experience?
        </h2>
        <p class="text-[var(--color-background)]/80 max-w-xl mx-auto mb-8 text-sm md:text-base">
          Visit us at Avondale Shopping Centre or book online to reserve your
          slot with Tafadzwa.
        </p>
        <a
          href="/contact"
          class="inline-block bg-[var(--color-primary)] hover:opacity-90 text-white font-bold py-3.5 px-8 rounded-full shadow-lg transition-all"
        >
          Book Your Appointment
        </a>
      </div>
    </div>
  </section>
</Layout>