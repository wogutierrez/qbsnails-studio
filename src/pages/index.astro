---
import Layout from "../layouts/layout.astro";
import ServiceCard from "../components/ServiceCard.astro";

// Highlighted featured services for the home page
const featuredServices = [
  {
    name: "Tafadzwa's Signature Gel Overlay",
    price: "$45 USD",
    duration: "60 mins",
    badge: "Most Popular",
    category: "Hands",
    description:
      "High-shine LED cured gel overlay designed for natural nail growth, structure reinforcement, and 3+ week durability.",
    image: {
      url: "https://images.unsplash.com/photo-1519014816548-bf5fe059798b?auto=format&fit=crop&w=600&q=80",
      alt: "Signature Gel Overlay",
    },
  },
  {
    name: "Avondale Luxury Spa Pedicure",
    price: "$55 USD",
    duration: "75 mins",
    badge: "Client Favorite",
    category: "Feet",
    description:
      "Warm mineral foot bath, eucalyptus scrub exfoliation, full nail grooming, and deep hydration massage.",
    image: {
      url: "https://images.unsplash.com/photo-1519014816548-bf5fe059798b?auto=format&fit=crop&w=600&q=80",
      alt: "Luxury Pedicure",
    },
  },
  {
    name: "Custom Hand-Painted Nail Art",
    price: "$15+ USD",
    duration: "30+ mins",
    badge: "Artisan",
    category: "Art",
    description:
      "Intricate floral lines, geometric patterns, gold leaf encapsulation, 3D charms, or custom chrome powders.",
    image: null,
  },
];

const highlights = [
  {
    icon: "🌿",
    title: "Non-Toxic & Health-First",
    desc: "We prioritize natural nail integrity using premium, damage-free gel systems.",
  },
  {
    icon: "💎",
    title: "Precision Craftsmanship",
    desc: "Every set is personally crafted or inspected by Master Specialist Tafadzwa Shiripinda.",
  },
  {
    icon: "✨",
    title: "Sterile & Hygienic",
    desc: "Hospital-grade autoclaved tools and single-use files for total peace of mind.",
  },
];
---

<Layout title="Qutiqled beauty Studio | Luxury Nail Salon in Avondale, Harare">
  {/* SECTION 1: HERO BANNER */}
  <section
    class="bg-gradient-to-b from-rose-50 via-pink-50/40 to-white py-16 md:py-24 px-4"
  >
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span
          class="text-xs font-bold uppercase tracking-widest text-rose-600 bg-rose-100 border border-rose-200 px-3.5 py-1.5 rounded-full inline-block mb-4"
        >
          📍 Avondale Shopping Centre, Harare
        </span>
        <h1
          class="text-4xl md:text-6xl font-black text-gray-900 leading-tight mb-6 tracking-tight"
        >
          Elegance Crafted for Your <span class="text-rose-600">Nails.</span>
        </h1>
        <p class="text-gray-600 text-lg leading-relaxed mb-8">
          😊 Welcome to Qutiqled Beauty Studio—Harare's premier destination for
          luxury gel overlays, spa pedicures, and bespoke hand-painted artwork
          led by <strong class="text-gray-800">Tafadzwa Shiripinda</strong>.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/services"
            class="bg-rose-600 hover:bg-rose-700 text-white font-bold py-3.5 px-8 rounded-full shadow-lg hover:shadow-xl transition-all text-center"
          >
            Explore Treatment Menu
          </a>
          <a
            href="/contact"
            class="bg-white hover:bg-rose-50 text-rose-600 font-bold border-2 border-rose-200 py-3.5 px-8 rounded-full transition-all text-center"
          >
            Book Appointment
          </a>
        </div>
      </div>

      {/* Hero Visual Box */}
      <div class="relative">
        <div
          class="aspect-square rounded-3xl bg-gradient-to-tr from-rose-200 to-pink-100 overflow-hidden shadow-2xl border-4 border-white relative flex items-center justify-center"
        >
          <img
            src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=800&q=80"
            alt="Qutiqled beauty Studio Nails"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur-md p-4 rounded-2xl border border-white/50 shadow-lg"
          >
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">
              Lead Specialist
            </p>
            <p class="text-sm font-extrabold text-gray-900">
              Tafadzwa Shiripinda
            </p>
            <p class="text-xs text-rose-600 font-medium">
              8+ Years Experience in Harare
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* SECTION 2: WHY CHOOSE US */}
  <section class="py-16 bg-white border-y border-rose-100">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-3">
          The Qutiqled Experience
        </h2>
        <p class="text-gray-600 text-sm md:text-base">
          We combine international gel standards with personalized African
          artistry.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          highlights.map((item) => (
            <div class="p-6 rounded-2xl bg-rose-50/50 border border-rose-100 text-center hover:bg-rose-50 transition-colors">
              <div class="text-4xl mb-3">{item.icon}</div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">{item.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* SECTION 3: FEATURED SERVICES PREVIEW */}
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <span
            class="text-xs font-bold uppercase tracking-widest text-rose-600"
            >Popular Treatments</span
          >
          <h2 class="text-3xl font-black text-gray-900 mt-1">
            Featured Services
          </h2>
        </div>
        <a
          href="/services"
          class="text-rose-600 font-bold text-sm hover:underline mt-4 md:mt-0"
        >
          View Full Menu & Pricing &rarr;
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          featuredServices.map((service) => (
            <ServiceCard
              name={service.name}
              price={service.price}
              duration={service.duration}
              badge={service.badge}
              category={service.category}
              description={service.description}
              image={service.image}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* SECTION 4: CALL TO ACTION BANNER */}
  <section class="py-16 px-4 bg-white">
    <div
      class="max-w-4xl mx-auto bg-slate-900 text-white rounded-3xl p-10 md:p-12 text-center shadow-2xl relative overflow-hidden"
    >
      <div class="relative z-10">
        <span
          class="text-xs font-bold uppercase tracking-widest text-rose-400 bg-rose-950 px-3.5 py-1 rounded-full inline-block mb-4"
        >
          Appointments Recommended
        </span>
        <h2 class="text-3xl md:text-4xl font-black mb-4">
          Ready for Your Studio Experience?
        </h2>
        <p class="text-slate-300 max-w-xl mx-auto mb-8 text-sm md:text-base">
          Visit us at Avondale Shopping Centre or book online to reserve your
          slot with Tafadzwa.
        </p>
        <a
          href="/contact"
          class="inline-block bg-rose-600 hover:bg-rose-700 text-white font-bold py-3.5 px-8 rounded-full shadow-lg transition-colors"
        >
          Book Your Appointment
        </a>
      </div>
    </div>
  </section>
</Layout>
