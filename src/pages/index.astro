---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { getCollection } from "astro:content";

// Fetch services
const allServices = await getCollection("services");

// Filter featured
const featuredEntries = [];
for (let i = 0; i < allServices.length; i++) {
  if (allServices[i].data && allServices[i].data.featured === true) {
    featuredEntries.push(allServices[i]);
  }
}

// Fallback
const displayEntries = featuredEntries.length > 0 ? featuredEntries : allServices.slice(0, 3);

// Format services
const services = displayEntries.map(function (entry) {
  return {
    name: entry.data.name,
    price: entry.data.price,
    duration: entry.data.duration,
    badge: entry.data.badge,
    category: entry.data.category,
    description: entry.data.description,
    image: entry.data.image ? {
      url: entry.data.image,
      alt: entry.data.name,
    } : null,
  };
});

// Highlights
const highlights = [
  {
    icon: "🌿",
    title: "Non-Toxic & Health-First",
    desc: "We prioritize natural nail integrity using premium, damage-free gel systems.",
  },
  {
    icon: "💎",
    title: "Precision Craftsmanship",
    desc: "Every set is personally crafted or inspected by Master Specialist Tafadzwa Shiripinda.",
  },
  {
    icon: "✨",
    title: "Sterile & Hygienic",
    desc: "Hospital-grade autoclaved tools and single-use files for total peace of mind.",
  },
];
---

<Layout title="Qutiqled Beauty Studio | Luxury Nail Salon in Avondale, Harare">

  <!-- SECTION 1: HERO -->
  <section class="hero-gradient py-5 py-md-6">
    <div class="container">
      <div class="row align-items-center g-5">
        <!-- Left Column -->
        <div class="col-lg-6">
          <span class="badge-custom mb-3">
            📍 Avondale Shopping Centre, Harare
          </span>
          
          <h1 class="display-4 fw-900 text-text mb-4">
            Elegance Crafted for Your
            <span class="text-primary-custom">Nails.</span>
          </h1>
          
          <p class="fs-5 text-text-secondary leading-relaxed mb-4">
            Welcome to Qutiqled Beauty Studio—Harare's premier destination for
            luxury gel overlays, spa pedicures, and bespoke hand-painted artwork
            led by
            <strong class="text-text">Tafadzwa Shiripinda</strong>.
          </p>
          
          <div class="d-flex flex-wrap gap-3">
            <a href="/services" class="btn btn-primary-custom">
              Explore Treatment Menu
            </a>
            <a href="/contact" class="btn btn-outline-custom">
              Book Appointment
            </a>
          </div>
        </div>
        
        <!-- Right Column -->
        <div class="col-lg-6">
          <div class="position-relative">
            <div class="bg-gradient-to-tr from-secondary/20 to-primary/20 overflow-hidden shadow-2xl border-4 border-background rounded-4 position-relative" style="aspect-ratio: 1/1;">
              <img
                src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=800&q=80"
                alt="Qutiqled Beauty Studio Nails"
                class="w-100 h-100 object-fit-cover"
              />
              
              <div class="position-absolute bottom-0 start-0 end-0 p-3" style="background: rgba(255,255,255,0.9); backdrop-filter: blur(8px); margin: 1rem; border-radius: 16px; border: 1px solid rgba(255,255,255,0.5);">
                <p class="text-uppercase text-text-secondary fw-bold mb-0" style="font-size: 0.65rem; letter-spacing: 0.05em;">
                  Lead Specialist
                </p>
                <p class="fw-900 text-text mb-0">
                  Tafadzwa Shiripinda
                </p>
                <p class="text-secondary-custom mb-0" style="font-size: 0.8rem;">
                  8+ Years Experience in Harare
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: WHY CHOOSE US -->
  <section class="py-5 bg-body border-top border-bottom" style="border-color: rgba(3, 152, 158, 0.2) !important;">
    <div class="container">
      <div class="text-center mx-auto mb-5" style="max-width: 600px;">
        <h2 class="section-title mb-2">
          The Qutiqled Experience
        </h2>
        <p class="section-subtitle">
          We combine international gel standards with personalized African artistry.
        </p>
      </div>
      
      <div class="row g-4">
        {highlights.map((item) => (
          <div class="col-md-4">
            <div class="p-4 rounded-4 text-center bg-secondary-soft border border-secondary border-opacity-10 hover-lift">
              <div class="display-4 mb-2">{item.icon}</div>
              <h3 class="fw-bold text-text mb-2">
                {item.title}
              </h3>
              <p class="text-text-secondary mb-0" style="font-size: 0.9rem;">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3: FEATURED SERVICES -->
  <section class="py-5" style="background-color: rgba(3, 152, 158, 0.05);">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5">
        <div>
          <span class="badge-custom d-inline-block mb-1" style="background-color: var(--primary);">
            Popular Treatments
          </span>
          <h2 class="section-title mt-1">
            Featured Services
          </h2>
        </div>
        <a href="/services" class="text-secondary-custom fw-bold text-decoration-none hover-underline">
          View All Services →
        </a>
      </div>
      
      <div class="row g-4">
        {services.map((service) => (
          <div class="col-md-4">
            <ServiceCard
              name={service.name}
              price={service.price}
              duration={service.duration}
              badge={service.badge}
              category={service.category}
              description={service.description}
              image={service.image}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4: CALL TO ACTION -->
  <section class="py-5 bg-body">
    <div class="container">
      <div class="bg-text text-background rounded-4 p-5 text-center shadow-lg position-relative overflow-hidden" style="background-color: var(--text) !important;">
        <div class="position-relative z-1">
          <span class="badge-custom d-inline-block mb-3" style="background-color: var(--accent) !important; color: var(--text) !important;">
            Appointments Recommended
          </span>
          
          <h2 class="display-6 fw-900 mb-3" style="color: white !important;">
            Ready for Your Studio Experience?
          </h2>
          
          <p class="text-white-50 mx-auto mb-4" style="max-width: 600px;">
            Visit us at Avondale Shopping Centre or book online to reserve your
            slot with Tafadzwa.
          </p>
          
          <a href="/contact" class="btn btn-primary-custom" style="background-color: var(--primary) !important; border-color: var(--primary) !important;">
            Book Your Appointment
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>