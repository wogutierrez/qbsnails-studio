---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { getCollection } from "astro:content";

const allServices = await getCollection("services");

const featuredEntries = [];
for (let i = 0; i < allServices.length; i++) {
  if (allServices[i].data && allServices[i].data.featured === true) {
    featuredEntries.push(allServices[i]);
  }
}

const displayEntries = featuredEntries.length > 0 ? featuredEntries : allServices.slice(0, 3);

const services = displayEntries.map(function (entry) {
  return {
    name: entry.data.name,
    price: entry.data.price,
    duration: entry.data.duration,
    badge: entry.data.badge,
    category: entry.data.category,
    description: entry.data.description,
    calLink: entry.data.calLink,
    image: entry.data.image ? {
      url: entry.data.image,
      alt: entry.data.name,
    } : null,
  };
});

const highlights = [
  {
    icon: "🌿",
    title: "Non-Toxic & Health-First",
    desc: "We prioritize natural nail integrity using premium, damage-free gel systems.",
  },
  {
    icon: "💎",
    title: "Precision Craftsmanship",
    desc: "Every set is personally crafted or inspected by Master Specialist Tafadzwa Shiripinda.",
  },
  {
    icon: "✨",
    title: "Sterile & Hygienic",
    desc: "Hospital-grade sterilized tools and single-use files for total peace of mind.",
  },
];
---

<Layout title="Qutiqled Beauty | Premium Nail Care Delivered to Your Door">

<!-- SECTION 1: HERO -->
<section style="background: #ffffff; padding-top: 5rem; padding-bottom: 5rem;">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <span class="badge-custom mb-3 d-inline-block">
          📍 Serving Harare & Surrounding Areas
        </span>
        <h1 class="display-4 fw-bold mb-4" style="color: #110303;">
          Premium Nail Care 
          <span style="color: var(--primary);">At Your Door.</span>
        </h1>
        <p class="fs-5 mb-4" style="color: #110303; line-height: 1.6;">
          Welcome to Qutiqled Beauty—Harare's trusted mobile nail service. 
          Quality gel overlays, spa pedicures, and detailed nail art, personally 
          crafted by qualified Nail Technician <strong>Tafadzwa Shiripinda</strong>.
        </p>

        <!-- Dynamic CTAs -->
        <div class="d-flex flex-wrap gap-3">
          <a href="/services#treatment-menu" class="btn btn-primary-custom">Hello Raquel</a>
          <a href="/services#treatment-menu" class="btn btn-outline-custom">Book Appointment</a>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="position-relative">
          
          <!-- PHOTO CONTAINER WITH SOFT NATURAL SHADOW -->
          <div class="overflow-hidden rounded-4 position-relative" style="aspect-ratio: 1/1; background: #ffffff; border: 4px solid #ffffff; box-shadow: 0 15px 35px rgba(0,0,0,0.08);">
            <img
              src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=800&q=80"
              alt="Qutiqled Beauty Nails by Tafadzwa"
              class="w-100 h-100 object-fit-cover"
            />

            <!-- DIPLOMA QUALIFIED OVERLAY CARD -->
            <div class="position-absolute bottom-0 start-0 end-0 p-3 m-3 rounded-4 shadow-sm" style="background: rgba(255, 255, 255, 0.95); border: 1px solid var(--secondary);">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <p class="text-uppercase fw-semibold mb-1" style="color: var(--primary); font-size: 0.7rem; letter-spacing: 0.05em;">
                    🎓 Diploma-Qualified Nail Technician
                  </p>
                  <p class="fw-bold mb-0 fs-5" style="color: #110303;">
                    Tafadzwa Shiripinda
                  </p>
                  <p class="mb-0" style="color: #555555; font-size: 0.85rem;">
                    Dedicated to healthy nails & personalized care in Harare
                  </p>
                </div>
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; background: rgba(3, 152, 158, 0.1); color: var(--primary); font-size: 1.1rem;">
                  ✨
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>


  <!-- SECTION 2: WHY CHOOSE US -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem;">
    <div class="container">
      <div class="text-center mx-auto mb-5" style="max-width: 600px;">
        <h2 class="fw-bold" style="color: #110303; font-size: 2.5rem;">The Qutiqled Experience</h2>
        <p style="color: #110303;">Professional nail care with the convenience of home service.</p>
      </div>
      <div class="row g-4">
        {highlights.map((item) => (
          <div class="col-md-4">
            <div class="p-4 rounded-4 text-center" style="background: #ffffff; border: 2px solid var(--secondary);">
              <div class="display-4 mb-2">{item.icon}</div>
              <h3 class="fw-bold mb-2" style="color: #110303;">{item.title}</h3>
              <p class="mb-0" style="color: #110303; font-size: 0.9rem;">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3: FEATURED SERVICES -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem;">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5">
        <div>
          <span class="badge-custom d-inline-block mb-1">Popular Treatments</span>
          <h2 class="fw-bold" style="color: #110303; font-size: 2.5rem;">Featured Services</h2>
        </div>
        <a href="/services" class="fw-bold text-decoration-none" style="color: var(--secondary);">View All Services →</a>
      </div>
      <div class="row g-4">
        {services.map((service) => (
          <div class="col-md-4">
            <ServiceCard
              name={service.name}
              price={service.price}
              duration={service.duration}
              badge={service.badge}
              category={service.category}
              description={service.description}
              image={service.image}
              calLink={service.calLink}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4: CALL TO ACTION -->
  <!-- COMMENTED 
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem; border-top: 2px solid var(--secondary);">
  -->
  <section style="background: #ffffff; padding-top: 4rem; padding-bottom: 4rem;">

    <div class="container">
      <div class="rounded-4 p-5 text-center" style="background: #110303;">
        <span class="badge-custom d-inline-block mb-3" style="background: var(--accent) !important; color: #110303 !important;">Book Your Home Service</span>
        <h2 class="display-6 fw-bold mb-3 text-white">Ready for the Qutiqled Experience?</h2>
        <p class="text-white-50 mx-auto mb-4" style="max-width: 600px;">Schedule your appointment and enjoy professional nail care in the comfort of your home.</p>
        <a href="/contact" class="btn btn-primary-custom">Book Your Appointment</a>
      </div>
    </div>
  </section>

</Layout>